{
  "manifest_version": 3,
  "name": "AEBOT — Assistente de Análise",
  "version": "2.17.1",
  "description": "Assistente de análise de serviços de campo baseado nas regras cadastradas",
  "key": "",
  "permissions": ["sidePanel"],
  "host_permissions": [
    "https://aebot-api.pedrolucasbotelho.workers.dev/*"
  ],
  "action": {
    "default_title": "Abrir AEBOT"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://aebot-api.pedrolucasbotelho.workers.dev"
  }
}
