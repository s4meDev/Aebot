{
  "name": "field-service-assistant",
  "version": "2.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:capacity": "node scripts/run-capacity-test.mjs",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "build:production": "npm run build && node scripts/configure-production-extension.mjs && node scripts/validate-production-extension.mjs",
    "build:server": "tsc -p tsconfig.server.json --noEmit && vite build --config vite.server.config.ts",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit && wrangler deploy --dry-run --outdir worker-dist",
    "build:all": "npm run build && npm run build:server && npm run build:worker",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "feedback:db:create": "wrangler d1 create aebot-feedback",
    "feedback:db:migrate:local": "wrangler d1 migrations apply aebot-feedback --local",
    "feedback:db:migrate": "wrangler d1 migrations apply aebot-feedback --remote",
    "server:setup": "node scripts/setup-local-server.mjs",
    "server:local": "npm run build:server && node server-dist/index.js",
    "server:start": "node server-dist/index.js",
    "server:check": "node --env-file-if-exists=.env.local scripts/check-server.mjs",
    "ai:check": "node scripts/check-local-ai.mjs",
    "tokens:generate": "node scripts/generate-access-tokens.mjs",
    "admin:token:generate": "node scripts/generate-admin-token.mjs",
    "extension:identity:generate": "node scripts/generate-extension-identity.mjs",
    "cloudflare:secrets:configure": "node scripts/configure-cloudflare-secrets.mjs",
    "deployment:check": "node scripts/verify-production-deployment.mjs",
    "pilot:check": "node scripts/validate-pilot-readiness.mjs",
    "rules:audit": "node scripts/audit-rules.mjs",
    "rules:format": "node scripts/format-rules.mjs",
    "rules:check": "npm run rules:audit && npm run typecheck && npm test",
    "validate": "npm test && npm run build:all && node scripts/validate-extension.mjs && node scripts/validate-server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
