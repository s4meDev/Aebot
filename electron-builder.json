{
  "appId": "br.com.aebot.desktop",
  "productName": "AEBOT",
  "directories": { "output": "desktop-release" },
  "files": ["desktop-dist/ui/**/*", "desktop-dist/main.cjs", "desktop-dist/preload.cjs", "desktop-dist/build-info.json", "package.json"],
  "extraMetadata": { "main": "desktop-dist/main.cjs" },
  "extraResources": [{ "from": "desktop-resources", "to": "local-ai", "filter": ["runtime-b11160-mix-a6922cc/**/*", "assets-lock.json", "licenses/**/*"] }],
  "asar": true,
  "npmRebuild": false,
  "forceCodeSigning": true,
  "afterSign": "scripts/verify-signed-runtime.mjs",
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "signAndEditExecutable": true, "signExts": [".dll"], "signtoolOptions": { "signingHashAlgorithms": ["sha256"] } },
  "nsis": { "include": "desktop/installer.nsh", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "AEBOT-${version}-Setup.exe" }
}
